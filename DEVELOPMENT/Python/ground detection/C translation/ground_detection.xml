<module name="ground_detection" dir="computer_vision">

  <doc>
    <description>
      Green ground detection and obstacle avoidance for the Parrot Bebop 1.
      Uses a hardcoded YUV decision tree (trained via ML) to classify ground
      pixels, isolates valid ground blobs, finds the ground boundary per
      column and detects obstacles by comparing the boundary to a running
      baseline.
    </description>
  </doc>

  <!-- Header automatically included by Paparazzi -->
  <header>
    <file name="ground_detection.h"/>
  </header>

  <!-- Function called automatically at drone startup -->
  <init fun="ground_detection_init()"/>

  <!-- Files to compile when building the firmware -->
  <makefile target="ap">
    <file name="ground_detection.c"/>
    <file name="colored_blob_separator.c"/>
    <file name="solidity_detection.c"/>

    <!-- Default FPS (0 = run at camera fps) -->
    <define name="GROUND_DETECTION_FPS" value="0"/>

    <!-- Minimum green pixel fraction to consider ground visible -->
    <define name="OA_COLOR_COUNT_FRAC" value="0.05"/>

    <!-- Blob filtering parameters -->
    <define name="BLOB_AREA_THRESHOLD" value="1000"/>

    <!-- Obstacle detection parameters -->
    <define name="OBSTACLE_THRESHOLD"  value="50"/>
    <define name="MIN_OBSTACLE_WIDTH"  value="20"/>
    <define name="MAX_COL_GAP"         value="5"/>
    <define name="MIN_GROUND_PIXELS"   value="5"/>
    <define name="NO_GROUND_BASELINE"  value="220"/>
    <define name="ALPHA"               value="0.6"/>
  </makefile>

</module>